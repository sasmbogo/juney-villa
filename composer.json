{
    "name": "juneyvilla/booking-system",
    "description": "Juney Villa Limited - Luxury Villa Rental & Booking Management System",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Juney Villa Limited",
            "email": "admin@juneyvillaszanzibar.co.tz"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^2.0",
        "endroid/qr-code": "^5.0",
        "firebase/php-jwt": "^6.10",
        "intervention/image": "^3.0",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "config/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 app/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
